# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Môi trường ảo
.venv/
venv/

# Cache của công cụ kiểm tra
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Biến môi trường chứa mật khẩu thật: chỉ commit file .env.example
.env
.env.*
!.env.example

# Khóa bí mật (ví dụ khóa age để mở task, khóa SSH): không bao giờ để trong repo
*.key
*.pem
id_rsa*
id_ed25519*

# Dữ liệu chạy local của Docker (nếu dùng bind mount thay cho named volume)
minio_data/
postgres_data/

# Log
*.log

# IDE / hệ điều hành (Windows tạo *:Zone.Identifier khi copy file từ Windows sang WSL)
.vscode/
.idea/
*.swp
*:Zone.Identifier
Thumbs.db
desktop.ini
.DS_Store
