# Mẫu biến môi trường cho docker-compose.yml
# Cách dùng: copy file này thành `.env` (cùng thư mục infra/) rồi đổi mật khẩu.
#   cp .env.example .env
# File `.env` đã nằm trong .gitignore — KHÔNG commit mật khẩu thật lên Git.

# PostgreSQL
POSTGRES_USER=docflow_admin
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=docflow_db

# MinIO (mật khẩu tối thiểu 8 ký tự)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio
